# Copy this file to `.env` and adjust as needed.
# All of these have safe defaults - you only need to set the ones you want
# to change. See app/config.py for the full list.

# --- Flask -------------------------------------------------------------
SECRET_KEY=change-me-to-something-random
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# --- Storage -------------------------------------------------------------
# DOWNLOAD_FOLDER=./downloads
# DATA_DIR=./data
# LOG_DIR=./logs

# --- Downloads -----------------------------------------------------------
MAX_CONCURRENT_DOWNLOADS=3
MAX_HISTORY_ITEMS=500

# --- yt-dlp ----------------------------------------------------------------
# Only needed for sites that require you to be logged in. Pick ONE:
# COOKIES_FROM_BROWSER=chrome
# COOKIES_FILE=/path/to/cookies.txt
SPONSORBLOCK_DEFAULT=false

# --- Security --------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from a different
# origin (leave blank for a same-origin-only app, which is the normal case
# for local personal use).
# ALLOWED_ORIGINS=

LOG_LEVEL=INFO
