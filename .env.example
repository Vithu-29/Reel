# Optional: copy to .env. Values are loaded before any configuration is read.
# Blank SECRET_KEY creates a random persistent key in data/session.key.
SECRET_KEY=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Paths may be absolute. Default storage is inside the project folder.
# DOWNLOAD_FOLDER=C:/Users/YourName/Downloads/Reel
# DATA_DIR=C:/Users/YourName/ReelData
# LOG_DIR=C:/Users/YourName/ReelLogs
MAX_CONCURRENT_DOWNLOADS=3
MAX_HISTORY_ITEMS=500
LOG_LEVEL=INFO

# Install FFmpeg with BOTH ffmpeg and ffprobe in PATH, or set its bin folder:
# FFMPEG_LOCATION=C:/ffmpeg/bin
# auto detects supported Deno (2.3+) and Node.js (22+) on PATH.
JS_RUNTIME=auto
# To choose a specific executable:
# JS_RUNTIME=node
# JS_RUNTIME_PATH=C:/Program Files/nodejs/node.exe

# stable or nightly; updates always require restarting the server.
YTDLP_CHANNEL=stable

# Optional, for content your own account is authorized to access. Choose ONE.
# COOKIES_FROM_BROWSER=firefox
# COOKIES_FILE=C:/Users/YourName/private-cookies.txt
SPONSORBLOCK_DEFAULT=false

# false for local http://127.0.0.1, true ONLY when served over HTTPS.
SESSION_COOKIE_SECURE=false
